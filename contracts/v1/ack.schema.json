{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajin-scrap-monitoring/scrap-monitoring-lidar-generator/contracts/v1/ack.schema.json",
  "title": "LiDAR scan acknowledgement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "type", "run_id", "sensor_id", "scan_id"],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "type": {
      "const": "ack"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sensor_id": {
      "type": "string",
      "minLength": 1
    },
    "scan_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  }
}
