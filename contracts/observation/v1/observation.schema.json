{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajin-scrap-monitoring/scrap-monitoring-lidar-generator/contracts/observation/v1/observation.schema.json",
  "title": "Load-model observation record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_version",
    "type",
    "sequence",
    "environment_id",
    "run_id",
    "input_fingerprint_sha256",
    "seed",
    "scene",
    "scenario",
    "surface"
  ],
  "properties": {
    "observation_version": {
      "const": 1
    },
    "type": {
      "const": "load_model_observation"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "scene": {
      "$ref": "#/$defs/scene"
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "surface": {
      "$ref": "#/$defs/surface"
    }
  },
  "$defs": {
    "coordinate2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "coordinate3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensor_id", "p0_m", "u0", "u90"],
      "properties": {
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "p0_m": {
          "$ref": "#/$defs/coordinate3"
        },
        "u0": {
          "$ref": "#/$defs/coordinate3"
        },
        "u90": {
          "$ref": "#/$defs/coordinate3"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_system",
        "length_unit",
        "angle_unit",
        "boundary_xy_m",
        "floor_z_m",
        "top_z_m",
        "inlet_positions_xy_m",
        "sensors"
      ],
      "properties": {
        "coordinate_system": {
          "const": "right-handed-z-up"
        },
        "length_unit": {
          "const": "m"
        },
        "angle_unit": {
          "const": "deg"
        },
        "boundary_xy_m": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/coordinate2"
          }
        },
        "floor_z_m": {
          "type": "number"
        },
        "top_z_m": {
          "type": "number"
        },
        "inlet_positions_xy_m": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coordinate2"
          }
        },
        "sensors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sensor"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_s",
        "surface_updated_at_s",
        "cycle_index",
        "phase",
        "phase_started_at_s",
        "phase_ends_at_s",
        "phase_duration_s",
        "rate_factor",
        "target_fill_ratio",
        "surface_fill_ratio",
        "surface_volume_m3",
        "current_inlet_index"
      ],
      "properties": {
        "elapsed_s": {
          "type": "number",
          "minimum": 0
        },
        "surface_updated_at_s": {
          "type": "number",
          "minimum": 0
        },
        "cycle_index": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": ["filling", "collecting"]
        },
        "phase_started_at_s": {
          "type": "number",
          "minimum": 0
        },
        "phase_ends_at_s": {
          "type": "number",
          "minimum": 0
        },
        "phase_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rate_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "target_fill_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surface_fill_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surface_volume_m3": {
          "type": "number",
          "minimum": 0
        },
        "current_inlet_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_size_m",
        "x_coordinates_m",
        "y_coordinates_m",
        "heights_m"
      ],
      "properties": {
        "cell_size_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "x_coordinates_m": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "y_coordinates_m": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "heights_m": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
