 2 files changed, 48 insertions(+)

diff --git a/services/lidar-processing/src/ajin_lidar_processing/engine.py b/services/lidar-processing/src/ajin_lidar_processing/engine.py
index a694fee..7239e94 100644
--- a/services/lidar-processing/src/ajin_lidar_processing/engine.py
+++ b/services/lidar-processing/src/ajin_lidar_processing/engine.py
@@ -242,6 +242,11 @@ class ProcessingEngine:
             self.frame_loss += 1
             return False
         self.blocked.discard(sid)
+        if receive_monotonic_ns is not None:
+            if old and old.instance_id == f.instance_id:
+                self.frame_loss += max(0, f.sequence - old.sequence - 1)
+            self.last[sid] = f
+            self.validated_history[sid].add((f.instance_id, f.sequence))
         # Replay has no receive clock: commit sequence/time history only after
         # measure validates its supplied clocks. Runtime can reject immediately.
         if len(self.buffers[sid]) == 10:
diff --git a/tests/test_processing.py b/tests/test_processing.py
index f826bb0..a44182b 100644
--- a/tests/test_processing.py
+++ b/tests/test_processing.py
@@ -308,6 +308,49 @@ def test_normal_history_eviction_is_not_frame_loss():
     assert e.frame_loss == 0
 
 
+def test_runtime_history_eviction_between_measurements_is_not_frame_loss():
+    e = engine()
+    for sid in ["a", "b"]:
+        e.ingest(
+            frame(sid, 1, 1_000_000_000),
+            receive_monotonic_ns=1_000_000_000,
+            receive_unix_ms=101000,
+        )
+    e.measure(1_000_000_000, 101000, {})
+
+    for seq in range(2, 13):
+        stamp = seq * 100_000_000 + 1_000_000_000
+        for sid in ["a", "b"]:
+            e.ingest(
+                frame(sid, seq, stamp),
+                receive_monotonic_ns=stamp,
+                receive_unix_ms=100000 + stamp // 1_000_000,
+            )
+
+    measurement = e.measure(2_200_000_000, 102200, {})
+
+    assert measurement is not None
+    assert [sensor["sequence"] for sensor in measurement["sensors"]] == [12, 12]
+    assert e.history_evictions == 4
+    assert e.frame_loss == 0
+
+
+def test_runtime_sequence_gap_is_frame_loss():
+    e = engine()
+    assert e.ingest(
+        frame(seq=1, stamp=1_000_000_000),
+        receive_monotonic_ns=1_000_000_000,
+        receive_unix_ms=101000,
+    )
+    assert e.ingest(
+        frame(seq=3, stamp=1_200_000_000),
+        receive_monotonic_ns=1_200_000_000,
+        receive_unix_ms=101200,
+    )
+
+    assert e.frame_loss == 1
+
+
 def test_malformed_global_angle_rejects_frame():
     e = engine()
     f = frame()
