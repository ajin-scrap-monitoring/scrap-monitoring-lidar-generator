# syntax=docker/dockerfile:1.20@sha256:26147acbda4f14c5add9946e2fd2ed543fc402884fd75146bd342a7f6271dc1d

ARG RUST_IMAGE=rust:1.96.0-slim-bookworm@sha256:4732ca96fd086cb9be682050c3f0176288eebaac2b80aa2bcefccfaf198e1950

FROM --platform=$BUILDPLATFORM ${RUST_IMAGE} AS builder

ARG TARGETARCH

WORKDIR /source

COPY Cargo.toml Cargo.lock rust-toolchain.toml build.rs ./
COPY contracts/lidar/v1/lidar.proto contracts/lidar/v1/lidar.proto
COPY src/ src/

RUN test "$TARGETARCH" = "arm64" \
    && rustup target add aarch64-unknown-linux-musl --toolchain 1.96.0 \
    && RUST_LLD_PATH="$(rustc --print sysroot)/lib/rustlib/x86_64-unknown-linux-gnu/bin/rust-lld" \
    && CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER="$RUST_LLD_PATH" \
       cargo build --locked --release \
       --target aarch64-unknown-linux-musl \
       --features edge-validation \
       --bin scrap-monitoring-lidar-simulator \
    && install -d /notices \
    && cp "$(rustc --print sysroot)/share/doc/rust/COPYRIGHT.html" \
       /notices/RUST_COPYRIGHT.html \
    && install -d -m 0755 -o 10001 -g 10001 /runtime-root/data

FROM scratch

LABEL org.opencontainers.image.source="https://github.com/ajin-scrap-monitoring/scrap-monitoring-lidar-generator" \
      org.opencontainers.image.title="Scrap Monitoring LiDAR Simulator Rust Candidate"

COPY --from=builder \
    /source/target/aarch64-unknown-linux-musl/release/scrap-monitoring-lidar-simulator \
    /usr/local/bin/scrap-monitoring-lidar-simulator
COPY licenses/THIRD_PARTY_NOTICES.html \
    /usr/share/doc/scrap-monitoring-lidar-simulator/THIRD_PARTY_NOTICES.html
COPY --from=builder /notices/RUST_COPYRIGHT.html \
    /usr/share/doc/scrap-monitoring-lidar-simulator/RUST_COPYRIGHT.html
COPY --from=builder --chown=10001:10001 /runtime-root/data /data

USER 10001:10001
WORKDIR /data
STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/local/bin/scrap-monitoring-lidar-simulator"]
CMD ["run"]
