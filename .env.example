# Non-secret deployment settings copied to each edge device.
# Generator configuration path inside the container.
SCRAP_LIDAR_GENERATOR_CONFIG=/config/generator.v2.json
# Mean duration of one filling phase in simulation seconds.
SCRAP_LIDAR_GENERATOR_MEAN_FILL_DURATION_S=86400
# Center of the per-cycle collection threshold range with a fixed 0.05 half-range.
SCRAP_LIDAR_GENERATOR_COLLECTION_THRESHOLD_CENTER_RATIO=0.90
# Directory containing the lidar_1.sock and lidar_2.sock scan endpoints.
SCRAP_LIDAR_GENERATOR_GRPC_SOCKET_DIR=/run/lidar
# Root directory containing one status subdirectory per emulated driver.
SCRAP_LIDAR_GENERATOR_STATUS_DIR=/status
# Deployment identity shared with lidar-processing.
SITE_ID=<site-id>
EDGE_ID=<edge-id>
CONFIG_REVISION=<config-revision>
DEPLOYMENT_REVISION=<deployment-revision>
# Observation receiver address; replace the reserved example domain.
SCRAP_LIDAR_GENERATOR_OBSERVATION_HOST=visualizer.example
# Observation receiver TCP port.
SCRAP_LIDAR_GENERATOR_OBSERVATION_PORT=17000
# Simulation interval between observation records.
SCRAP_LIDAR_GENERATOR_OBSERVATION_INTERVAL_S=1
# Diagnostic recording switch.
SCRAP_LIDAR_GENERATOR_DIAGNOSTICS_ENABLED=true
# Diagnostic output path inside the container.
SCRAP_LIDAR_GENERATOR_DIAGNOSTICS_OUTPUT_PATH=/data/diagnostics
